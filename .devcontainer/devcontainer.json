{
  "name": "Flutter Bonfire Lab",
  "image": "ghcr.io/cirruslabs/flutter:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "dart.openDevTools": "never",
        "dart.hotReloadOnSave": "all"
      }
    }
  },
  "forwardPorts": [
    8080,
    8081
  ],
  "portsAttributes": {
    "8080": {
      "label": "Bonfire Game View",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    },
    "8081": {
      "label": "Flutter VM Service",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "flutter config --enable-web && flutter pub get",
  "remoteUser": "root"
}